# Postgres (local: `pnpm infra:up`)
DATABASE_URL=postgres://solver:solver@localhost:5432/solver
REDIS_URL=redis://localhost:6379

# LLM
OPENROUTER_API_KEY=
# Comma-separated fallbacks used ONLY when the locked model is refused; every swap is recorded and shown.
LLM_FALLBACK_MODELS=

# Solana (phase 2)
SOLANA_RPC_URL=
SOLANA_CLUSTER=devnet

# Browser / sandbox (phase 2)
BROWSERBASE_API_KEY=
BROWSERBASE_PROJECT_ID=
PYTH_API_KEY=
E2B_API_KEY=

# IPFS (phase 2)
PINATA_JWT=

# Live launches (all required): treasury that receives creator fees (Squads multisig)
TREASURY_ADDRESS=
# Website build-time: RPC the browser uses to send signed launch txs
NEXT_PUBLIC_SOLANA_RPC=
NEXT_PUBLIC_API_URL=http://localhost:4000
